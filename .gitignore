.build
# Alternate SwiftPM scratch paths (swift build --scratch-path .build-<tag>):
# A/B builds keep their own object trees so the primary one stays intact —
# .build-wgpu was the first, compiler-flag experiments add more.
.build-*
dist
# Python bytecode: Scripts/*.py are run directly, but importing one (to reuse
# its regexes from a probe) leaves a cache dir behind.
__pycache__/
xcuserdata
Hyperfocal.xcodeproj
.DS_Store
# QtShell/build is the dev loop's tree; build-release is the one
# Scripts/package-windows.ps1 configures (release bridge, never clobbering it).
QtShell/build
QtShell/build-release
