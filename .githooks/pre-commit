#!/bin/bash
# Versioned hooks: enable them once per clone with
#     git config core.hooksPath .githooks
#
# Three checks, each skipped when the commit can't affect it:
#
#  1. Rejects a staged Localizable.xcstrings that carries Xcode's rewrite (see
#     Scripts/check-xcstrings.sh for what that is and why it's never wanted).
#     Checks the *staged* content, not the working tree, so `git add -p` and
#     partial stages are judged on what would actually land.
#
#  2. Translation coverage across both UIs (Scripts/check-translations.py):
#     every user-facing string wrapped, in the catalog, and translated into
#     all ten languages. This one reads the working tree — it spans a dozen
#     files and the staged-content dance isn't worth it — so a partial stage
#     is judged on what you have, not purely on what lands.
set -euo pipefail

CATALOG=App/Resources/Localizable.xcstrings
STAGED="$(git diff --cached --name-only --diff-filter=ACM)"

if grep -qx "$CATALOG" <<<"$STAGED"; then
    # The template needs its X's: BSD/macOS mktemp appends a suffix on its
    # own, but GNU mktemp (Git Bash, Linux) rejects "too few X's".
    TMP="$(mktemp -t xcstrings.XXXXXX)"
    trap 'rm -f "$TMP"' EXIT
    git show ":$CATALOG" > "$TMP"
    Scripts/check-xcstrings.sh "$TMP"
fi

# Anything that can introduce or orphan a user-facing string.
if grep -qE '^(App/Resources/Localizable\.xcstrings|QtShell/.*\.(qml|cpp|h)|AppCore/.*\.swift|Sources/HyperfocalKit/.*\.swift)$' <<<"$STAGED"; then
    # Explicit interpreter: the script's python3 shebang doesn't resolve on
    # Windows (see Scripts/python-interpreter.sh).
    "$(Scripts/python-interpreter.sh)" Scripts/check-translations.py
fi

# 3. The per-platform notices (Packaging/notices/) are generated from
#    NOTICE.md; reject a commit that changes one without the other.
if grep -qE '^(NOTICE\.md|Packaging/notices/)' <<<"$STAGED"; then
    "$(Scripts/python-interpreter.sh)" Scripts/gen-notices.py --check
fi

# 4. The wgpu attribution bundle is generated from the pinned tag; moving the
#    pin without regenerating it ships notices for the wrong crate versions.
if grep -qE '^(Scripts/fetch-wgpu\.sh|licenses/wgpu-native-ThirdPartyNotices\.txt)$' <<<"$STAGED"; then
    "$(Scripts/python-interpreter.sh)" Scripts/gen-wgpu-notices.py --check
fi
